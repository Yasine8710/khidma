#!/bin/sh
# Blocks commits that add secrets. Enable once per clone:
#   git config core.hooksPath scripts/hooks
# Needs gitleaks 8.19+ on PATH (Windows: winget install Gitleaks.Gitleaks).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed, secret scan skipped" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --config .gitleaks.toml --redact

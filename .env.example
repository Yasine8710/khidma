# Names of the public client settings. Pass them with --dart-define or
# --dart-define-from-file=config/dev.json (see app/config/dev.example.json).
# Nothing reads a .env file. Anon key only; never a service-role key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
GOOGLE_MAPS_API_KEY=your-maps-key
